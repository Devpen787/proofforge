{
  "name": "proofforge",
  "version": "0.0.0",
  "private": true,
  "description": "Proof layer for existing human-agent software work.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "convert:lead": "tsx apps/runner/src/convertWorkLead.ts",
    "import:ethglobal": "tsx apps/runner/src/importEthGlobalPrizes.ts",
    "import:github": "tsx apps/runner/src/importGitHubIssue.ts",
    "import:github-history": "tsx apps/runner/src/importGitHubHistory.ts",
    "0g:check": "tsx apps/runner/src/checkZeroGConfig.ts",
    "0g:set-key": "tsx apps/runner/src/setZeroGPrivateKey.ts",
    "0g:upload-record": "tsx apps/runner/src/uploadNetworkRecordToZeroG.ts",
    "demo:packet": "tsx apps/runner/src/demoPacket.ts",
    "eas:payload": "tsx apps/runner/src/createEasAttestationPayload.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "github:handoff": "tsx apps/runner/src/createGitHubHandoff.ts",
    "sync:web-proof": "tsx scripts/generateWebProofData.ts",
    "dev": "npm run dev -w apps/web",
    "release:payout": "tsx apps/runner/src/releasePayout.ts",
    "sync:publish-record": "tsx apps/runner/src/syncNetworkRecord.ts publish",
    "sync:publish-project": "tsx apps/runner/src/syncProjectRecord.ts publish",
    "sync:pull-record": "tsx apps/runner/src/syncNetworkRecord.ts pull",
    "sync:pull-project": "tsx apps/runner/src/syncProjectRecord.ts pull",
    "verify:acceptance": "tsx apps/runner/src/verifyAcceptanceSignature.ts",
    "smoke:web": "tsx scripts/smokeWeb.ts",
    "smoke:web:prod": "PROOFFORGE_BASE_URL=https://proofforgehub.vercel.app tsx scripts/smokeWeb.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.12.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "overrides": {
    "axios": "1.16.0"
  }
}
